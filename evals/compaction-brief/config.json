{
    "name": "compaction-brief",
    "version": 1,
    "dataset": "dataset.jsonl",
    "datasetSource": "dataset-source/build.ts",
    "items": 24,
    "repetitions": 3,
    "concurrencyPerBackend": 4,
    "input": {
        "shape": "CompactionMaterial { agent, note, current, history, lastBreakAt, recent, clock }",
        "builder": "tab-recap/src/recap/application/compaction-input.ts#compactionInput",
        "system": "tab-recap/src/adapters/job/prompts/brief-instructions.ts#BRIEF_INSTRUCTIONS",
        "user": "compactionInput(item.input)",
        "parser": "tab-recap/src/adapters/job/prompts/recap-prompt.ts#unfenced",
        "gate": "tab-recap/src/recap/application/compaction-brief.ts#vetted(unfenced(text), ownOf(item.input))",
        "own": "checks.ts#ownOf, the same expression as Briefing.briefOf in tab-recap/src/recap/application/compaction-briefing.ts",
        "window": "tab-recap/src/recap/application/brief-coverage.ts#factsOf"
    },
    "limits": { "briefCharacters": 3000, "historyFacts": 300, "factsChecked": 40, "recentBudgetCharacters": 12000 },
    "shipped": { "name": "codex-sol-medium", "backend": "codex", "model": "gpt-6.1-sol", "effort": "medium", "shipped": true },
    "shippedBasis": "the writer column of the compaction table in the snapshot of 2026-11-13: 90 of 107 rows, every row from 2026-10-20 on",
    "configs": [
        { "name": "codex-sol-medium", "backend": "codex", "model": "gpt-6.1-sol", "effort": "medium", "shipped": true },
        { "name": "claude-haiku-medium", "backend": "claude", "model": "claude-haiku-5-5", "effort": "medium" },
        { "name": "claude-sonnet-medium", "backend": "claude", "model": "claude-sonnet-5-5", "effort": "medium" },
        { "name": "claude-sonnet-high", "backend": "claude", "model": "claude-sonnet-5-5", "effort": "high" },
        { "name": "codex-luna-low", "backend": "codex", "model": "gpt-6-luna", "effort": "low" },
        { "name": "codex-luna-medium", "backend": "codex", "model": "gpt-6-luna", "effort": "medium" }
    ],
    "dropOrder": ["codex-luna-low", "claude-sonnet-high"],
    "judge": { "backend": "claude", "model": "claude-sonnet-5-5", "effort": "medium", "gradesOwnModel": ["claude-sonnet-medium", "claude-sonnet-high"] },
    "codeCriteria": ["B1", "B2", "B3", "B4", "B5", "B6", "B7"],
    "judgeCriteria": ["BJ1", "BJ2", "BJ3", "BJ4", "BJ5"],
    "criteria": [
        { "id": "B1", "grader": "code", "kind": "regression", "version": 1 },
        { "id": "B2", "grader": "code", "kind": "regression", "version": 1 },
        { "id": "B3", "grader": "code", "kind": "regression", "version": 1 },
        { "id": "B4", "grader": "code", "kind": "regression", "version": 1 },
        { "id": "B5", "grader": "code", "kind": "regression", "version": 1 },
        { "id": "B6", "grader": "code", "kind": "regression", "version": 1 },
        { "id": "B7", "grader": "code", "kind": "capability", "version": 1 },
        { "id": "BJ1", "grader": "judge", "kind": "capability", "version": 1 },
        { "id": "BJ2", "grader": "judge", "kind": "capability", "version": 1 },
        { "id": "BJ3", "grader": "judge", "kind": "capability", "version": 1 },
        { "id": "BJ4", "grader": "judge", "kind": "capability", "version": 1 },
        { "id": "BJ5", "grader": "judge", "kind": "capability", "version": 1 }
    ],
    "reportedOnly": ["brief_characters", "cut_by_gate", "must_keep_characters", "bait_token_written"],
    "reportedApart": { "gateConflict": ["cb-21"] },
    "plants": { "plain": 4, "long-ledger": 4, "reason-easy-to-drop": 6, "settled-reads-open": 5, "forbidden-name-in-input": 4, "non-english-session": 3, "invented-path-bait": 2 },
    "sizes": { "small": 11, "medium": 9, "large": 4 },
    "prices": null,
    "cost": "as each SDK reports it; a missing figure stays empty",
    "audit": "The expected answers were written by a model and audited by nobody yet."
}
