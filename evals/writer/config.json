{
  "name": "writer",
  "job": "Recap writer (inventory 1)",
  "version": 1,
  "dataset": "dataset.jsonl",
  "dataset_items": 24,
  "fresh": {
    "dataset": "dataset-fresh.jsonl",
    "items": 24,
    "seed": "fresh-1/2026-11-14",
    "plants": { "close-bait-intent": 6, "close-bait-partial": 6, "close-bait-other": 6, "close-bait-retracted": 6, "close-bait-hidden": 6, "quotable-close": 20, "quiet": 2 },
    "sizes": { "small": 14, "medium": 8, "large": 2 },
    "traps": { "refused": 0, "kept": 30 },
    "close_evidence_refused": 6
  },
  "dataset_origin": "mocked: invented content of fictional projects, shaped like the real writer inputs; built by build-dataset.ts, checked by check-dataset.ts",
  "audit": "The expected answers were written by a model and audited by nobody yet.",
  "repetitions": 3,
  "unit": "the first writer answer to one item, before any correction round",
  "prompt": {
    "system": "instructions(request) from tab-recap/src/adapters/job/prompts/recap-instructions.ts",
    "user": "writerContext(request, TRANSCRIPT_BUDGET) from tab-recap/src/recap/application/writer-context.ts",
    "parser": "parseAnswer from tab-recap/src/recap/application/ops-answer.ts",
    "gates": "LEDGER_GATES through judge() from tab-recap/src/recap/application/ops-gating.ts"
  },
  "shipped": "codex-luna-medium",
  "shipped_basis": "the store shows the writer on codex/gpt-6-luna; medium is the plugin default of TAB_RECAP_EFFORT; the owner's live setting was not read",
  "ladder": [
    { "name": "codex-luna-medium", "backend": "codex", "model": "gpt-6-luna", "effort": "medium", "shipped": true },
    { "name": "codex-luna-low", "backend": "codex", "model": "gpt-6-luna", "effort": "low" },
    { "name": "codex-sol-medium", "backend": "codex", "model": "gpt-6.1-sol", "effort": "medium" },
    { "name": "claude-haiku-medium", "backend": "claude", "model": "claude-haiku-5-5", "effort": "medium" },
    { "name": "claude-sonnet-medium", "backend": "claude", "model": "claude-sonnet-5-5", "effort": "medium" },
    { "name": "claude-sonnet-high", "backend": "claude", "model": "claude-sonnet-5-5", "effort": "high" },
    { "name": "codex-terra-medium", "backend": "codex", "model": "gpt-6.1-terra", "effort": "medium" }
  ],
  "judge": { "backend": "claude", "model": "claude-sonnet-5-5", "effort": "medium", "blind_to": ["configuration", "model", "effort", "repetition"], "graded_by_own_model": ["claude-sonnet-medium", "claude-sonnet-high"] },
  "criteria": [
    { "id": "W1", "grader": "code", "kind": "regression", "applies_to": "all items" },
    { "id": "W1s", "grader": "code", "kind": "regression", "applies_to": "all items" },
    { "id": "W2.G1", "grader": "code", "kind": "regression", "applies_to": "all items" },
    { "id": "W2.G2", "grader": "code", "kind": "regression", "applies_to": "all items" },
    { "id": "W2.G3", "grader": "code", "kind": "regression", "applies_to": "all items" },
    { "id": "W2.G5", "grader": "code", "kind": "regression", "applies_to": "all items" },
    { "id": "W2.G6", "grader": "code", "kind": "regression", "applies_to": "all items" },
    { "id": "W2.G10", "grader": "code", "kind": "regression", "applies_to": "all items" },
    { "id": "W2.G11", "grader": "code", "kind": "regression", "applies_to": "all items" },
    { "id": "W2.G12", "grader": "code", "kind": "regression", "applies_to": "all items" },
    { "id": "W2.L", "grader": "code", "kind": "regression", "applies_to": "all items" },
    { "id": "W3", "grader": "code", "kind": "regression", "applies_to": "expected.quiet is false (16 items)" },
    { "id": "W4", "grader": "code", "kind": "regression", "applies_to": "expected.quiet is true (8 items)" },
    { "id": "W5", "grader": "code", "kind": "regression", "applies_to": "all items" },
    { "id": "W10", "grader": "code", "kind": "regression", "applies_to": "a key fact of section decisions (4 items)" },
    { "id": "W12a", "grader": "code", "kind": "capability", "applies_to": "expected.must_close is not empty (8 items)" },
    { "id": "W12b", "grader": "code", "kind": "regression", "applies_to": "expected.must_stay is not empty (24 items)" },
    { "id": "W13a", "grader": "code", "kind": "regression", "applies_to": "expected.must_rewrite is not null (3 items)" },
    { "id": "W13b", "grader": "code", "kind": "capability", "applies_to": "expected.must_rewrite is not null (3 items)" },
    { "id": "WJ1", "grader": "judge", "kind": "capability", "applies_to": "expected.quiet is false (16 items)" },
    { "id": "WJ2", "grader": "judge", "kind": "capability", "applies_to": "answers that keep an add or an update" },
    { "id": "WJ3", "grader": "judge", "kind": "regression", "applies_to": "answers that keep an add" },
    { "id": "WJ4", "grader": "judge", "kind": "capability", "applies_to": "answers that keep an add or an update" }
  ],
  "outputs": "$HOME/.local/state/tab-recap-evals/suite/writer/runs/<label>/",
  "planned_calls": { "job": 504, "judge_at_most": 504 },
