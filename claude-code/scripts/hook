#!/bin/sh
event=${1:-}
[ "${HERDR_ENV:-}" = 1 ] && exit 0
[ "${SESSION_LEDGER_WRITER:-}" = 1 ] && exit 0
if [ "${SESSION_LEDGER_HEADLESS:-}" != on ] && [ "${CLAUDE_CODE_ENTRYPOINT:-}" != cli ]; then
    exit 0
fi
if [ "$event" = PreCompact ] && [ "${SESSION_LEDGER_PRECOMPACT:-}" != on ]; then
    exit 0
fi
command -v bun >/dev/null 2>&1 || exit 0
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." 2>/dev/null && pwd -P) || exit 0
state=${SESSION_LEDGER_STATE_DIR:-${XDG_STATE_HOME:-${HOME:-/nonexistent}/.local/state}/session-ledger/claude-code}
log=/dev/null
mkdir -p "$state" 2>/dev/null && ( : >>"$state/claude-code.log" ) 2>/dev/null && log=$state/claude-code.log
bun "$root/src/main.ts" "$event" 2>>"$log" || :
exit 0
