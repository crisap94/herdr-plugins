# Copy to ~/.config/herdr/plugins/config/tab-recap/config.env (herdr plugin config-dir tab-recap).
# Real environment variables win over this file. Re-read on every recap: no restart needed,
# except for the policy keys marked (restart).

# Who writes the recap: auto (the first available of claude → codex → opencode → hermes), one of
# claude | codex | opencode | hermes, or custom (see TAB_RECAP_CUSTOM_CMD).
TAB_RECAP_BACKEND=auto
# Each backend keeps its own model; empty = the harness default (claude → haiku). opencode wants
# provider/model. Set from the CLI with: node bin/tab-recap.ts backend codex gpt-6-luna
# (the older TAB_RECAP_CLAUDE_MODEL / TAB_RECAP_CODEX_MODEL are still read; TAB_RECAP_MODEL applies
# to a backend chosen by name, never to auto)
TAB_RECAP_MODEL_CLAUDE=
TAB_RECAP_MODEL_CODEX=
TAB_RECAP_MODEL_OPENCODE=
TAB_RECAP_MODEL_HERMES=
# custom backend: a command line (no shell) that reads the prompt on stdin (the version 2 recap_input document,
# then the instructions) and prints the operations on stdout: {"ops": [{"op": "add", ...}, {"op": "close", "id": "f3", "why": "done"}]}.
# The old recap JSON is refused (see the README, "Your own command"). It is yours to keep tool-less.
TAB_RECAP_CUSTOM_CMD=
# The language of the plugin's own words (column, footer, command messages): auto | en | es.
# auto reads LC_ALL, then LC_MESSAGES, then LANG.
TAB_RECAP_LOCALE=auto
# The language the recap is written in: ui (follow the locale) | en | es | a language name such as
# Português (letters, spaces and hyphens, at most 30 characters and 3 words). Changing it rewrites the recap at once.
TAB_RECAP_RECAP_LANG=ui

# The recap writer's view of the ledger. Pruning is off until the recall replay has passed its quality bar.
# When on, done and links keep the newest K facts per task; next keeps facts seen within the configured hours,
# up to K. Goal, now, needs, decisions and rules always keep every open fact. Hidden facts stay in the ledger.
TAB_RECAP_WRITER_PRUNE=off
TAB_RECAP_WRITER_KEEP_NEWEST=10
TAB_RECAP_WRITER_NEXT_HOURS=24

# How hard the recap writer thinks: low | medium (default) | high | default (pass nothing: the agent's own setting).
# Low records the operator's choices as open questions instead of decisions (measured on a 10-prompt replay); medium records them with their why.
# Mapped per agent: codex model_reasoning_effort, claude --effort, opencode --variant (minimal for low), hermes --reasoning.
TAB_RECAP_EFFORT=medium

# The git note under each agent: ⎇ branch · N unpushed · M changed (on | off; read at call time, no restart).
TAB_RECAP_GIT_NOTE=on

# Add the constant tab_recap.job OpenTelemetry resource attribute to Claude and Codex job harnesses.
TAB_RECAP_TELEMETRY_TAGS=off

# Compaction (tab-recap.compact, or `c` in the column). Which agents it reaches: focused (default), all, or kinds (claude,codex,opencode).
TAB_RECAP_COMPACT_TARGET=focused
# The note: ask (default) opens a note popup before the compaction is queued; skip queues it at once with no note and no popup.
# `tab-recap compact --note "<text>"` always queues at once with that note. Read on every use, no restart.
TAB_RECAP_COMPACT_NOTE=ask
# The compaction brief is a job of its own: which harness writes what the agent must keep, with which model and effort.
# BY: recap (the recap writer's harness, default) | auto | claude | codex | opencode | hermes | custom | off (the template only).
TAB_RECAP_COMPACT_BY=recap
# MODEL: empty = the harness's configured model (TAB_RECAP_MODEL_<HARNESS>). EFFORT: low | medium | high (default) | default.
TAB_RECAP_COMPACT_MODEL=
TAB_RECAP_COMPACT_EFFORT=high
# The recap judge (`tab-recap eval`) is a job of its own: which harness scores stored recaps, with which model and effort.
# BY: recap (the recap writer's harness, default) | auto | claude | codex | opencode | hermes | custom | off. MODEL: empty = the writer's. EFFORT: medium (default).
TAB_RECAP_JUDGE_BY=recap
TAB_RECAP_JUDGE_MODEL=
TAB_RECAP_JUDGE_EFFORT=medium
# Days to keep each run's input document (compressed) so the judge can score a recap against what the writer saw. 0 keeps none.
TAB_RECAP_KEEP_INPUT_DAYS=14
# A lane whose context reaches this share (10-95) of its window shows `compact? 45% of 1M`; off hides the hint. Advisory only.
TAB_RECAP_COMPACT_HINT=40
# Autocompact: compact an idle agent by itself when its context is full and nothing is half done. off | shadow (default: decide, record
# and log, never type; read the decisions with `tab-recap autocompact`) | on (also compact). Read on every decision, no restart.
TAB_RECAP_AUTOCOMPACT=shadow
# Ceiling override: at the ceiling a failed brief check does not block the compaction; the missed facts are appended to the brief. off restores the block.
TAB_RECAP_AUTOCOMPACT_CEILING_OVERRIDES_CHECK=on
# Backoff after a failed brief check below the ceiling, in ms: 0 is off; otherwise 60000 to 86400000.
TAB_RECAP_AUTOCOMPACT_COVERAGE_BACKOFF_MS=0
# Days a checked brief is kept for replay: 0 keeps none, 1 to 60.
TAB_RECAP_KEEP_BRIEF_DAYS=14
# The minimum (10-95): from this context share an idle agent is evaluated, and every safe moment compacts.
TAB_RECAP_AUTOCOMPACT_AT=10
# The style: how eagerly autocompact acts. gentle waits for a clearer moment; balanced (default) is today's numbers; eager acts sooner and asks an
# idle lane again after 30 min. It sets the verdict's numbers, the brief check's pass mark, the ceiling and the cooldown below (when unset) and the re-check.
# The table is in the README's Autocompact section. Read on every decision, no restart.
TAB_RECAP_AUTOCOMPACT_STYLE=balanced
# The ceiling (10-95, above the minimum) compacts without asking. Unset, the style's: 85 gentle · 80 balanced · 65 eager.
# TAB_RECAP_AUTOCOMPACT_CEILING=80
# After a compaction, or a decision to wait, a lane is left alone this long (ms). Unset, the style's: 1200000 gentle · 600000 balanced · 300000 eager.
# TAB_RECAP_AUTOCOMPACT_COOLDOWN_MS=600000
# Advanced, each optional: an out-of-range or invalid value is the style's number. The verdict's safe number (0.05-0.50, warnings at most) must stay below
# the undecided band's start, and its close number (0.50-0.95, closes or changes subject at least) above the band's end; otherwise the style's number.
# The brief check's pass mark is 0.30-0.95. The re-check: an idle lane whose last decision was `wait` (or undecided) at unchanged tokens is asked again
# once it has been idle this long (60000-86400000 ms); each re-check is one decider call, in shadow too. Never with gentle and balanced.
# TAB_RECAP_AUTOCOMPACT_SAFE_AT_MOST=0.30
# TAB_RECAP_AUTOCOMPACT_CLOSES_AT_LEAST=0.70
# TAB_RECAP_AUTOCOMPACT_COVERAGE_AT_LEAST=0.70
# TAB_RECAP_AUTOCOMPACT_RECHECK_IDLE_MS=1800000
# Herdr events: off (default) writes no pane token and answers no compaction request; on shares each lane's tokens (tab-recap-api, -share, -recap, -needs)
# and answers `compact-req-<tool>` requests on herdr's event stream. Read on every use, no restart.
TAB_RECAP_HERDR_EVENTS=off
# The agent kinds that are compacted. Other compactable kinds are decided and recorded, never compacted.
TAB_RECAP_AUTOCOMPACT_KINDS=claude
# Kinds kept shadow-only even when also listed in TAB_RECAP_AUTOCOMPACT_KINDS; default empty.
TAB_RECAP_AUTOCOMPACT_SHADOW_KINDS=
# The decider is a job of its own: who answers the yes/no questions about the last turns.
# BY: recap (the recap writer's harness, default) | auto | claude | codex | opencode | hermes | custom | jev (the TypeSafe API) | off.
TAB_RECAP_AUTOCOMPACT_BY=recap
TAB_RECAP_AUTOCOMPACT_MODEL=
TAB_RECAP_AUTOCOMPACT_EFFORT=low
# The brief check (before an automatic compaction types the brief): auto (default: jev when a key is found, else the decider above) |
# jev (always; with no key the check cannot run, so the compaction waits) | decider (the decider above).
# `auto` (the default) sends the brief and its facts to the remote Jev service as soon as a TypeSafe key is found, whatever `TAB_RECAP_AUTOCOMPACT_BY` says; set `decider` to keep the check on your own harness.
TAB_RECAP_AUTOCOMPACT_COVERAGE_BY=auto
# With BY=jev, the last prompt and reply, recent turns, goal and open work go to that service (and the brief and its facts
# when the brief is checked). The endpoint must be https:// (http:// only to localhost); anything else is the default.
# The endpoint (any compatible gateway) and the pinned model. The key is read at call time from TAB_RECAP_JEV_KEY
# (environment or this file), else TYPESAFE_API_KEY, else the file ~/.config/typesafe-api-key. It is never logged or shown.
TAB_RECAP_JEV_URL=https://api.typesafe.ai/v1/systemone
TAB_RECAP_JEV_MODEL=jev-1.13.0
# Tokens an agent can hold, to measure its context. Empty = found at runtime (the agent's own data, opencode's local model
# catalogue, a built-in table for claude, raised when more has been seen in use). A number overrides all of that.
TAB_RECAP_CONTEXT_WINDOW=

# The curator (the full-screen view): closes duplicate facts as merged and writes the "session so far" paragraph, when the view opens.
# BY: recap (the recap writer's harness, default) | auto | claude | codex | opencode | hermes | custom | off. MODEL: empty = the harness's configured model.
TAB_RECAP_CURATE_BY=recap
TAB_RECAP_CURATE_MODEL=
TAB_RECAP_CURATE_EFFORT=medium

# How a run reads its new turns: one (a single call, the default) | enumerate | enumerate+gates | full (list the facts of every chunk with a
# quote at low effort, take one second look when the turn was long or the list short, then reconcile with the ledger). Measured in
# experiments/EXP-001: the piped ones did not recall more than `one` and cost 2.4–2.8× the calls, so they are off unless you ask.
TAB_RECAP_PIPELINE=one
# Turns between two reconciliations of the open facts by the curator (it also reconciles after a compaction and when the view opens).
TAB_RECAP_RECONCILE_EVERY=8

# Column width: a fraction of the tab, clamped to [MIN, MAX] cells.
TAB_RECAP_WIDTH=0.3
TAB_RECAP_MIN_COLS=36
TAB_RECAP_MAX_COLS=64
# (restart) Tabs narrower than this (a phone client) get a one-row bar along the top instead of a side column.
TAB_RECAP_MIN_TAB_COLS=110
# (restart) A close the daemon asked for and herdr has not done after this long (ms) is asked again, and counts against the reopen budget.
TAB_RECAP_CLOSE_GRACE_MS=30000
# (restart) Agent kinds that get a column. Their history is read from claude's and codex's transcripts and
# opencode's database.
TAB_RECAP_AGENTS=claude,codex,opencode
# (restart) More kinds that get a column, read from the pane's SCREEN (no transcript): a comma list, or `all`.
# Coarser than a transcript (an agent on the alternate screen shows only what is visible); never typed into.
TAB_RECAP_SCREEN_AGENTS=
# (restart) Staged rollout: only these tabs get a column (comma list of tab ids). Empty = all.
TAB_RECAP_TABS=

# How long a closed tab's recap history is kept: a tab nobody has seen for this many days and with no column open is removed
# with its runs, chapters and compaction records, once a day. 0 keeps everything.
TAB_RECAP_KEEP_DAYS=30

# Markdown rendering: auto (glow if installed) | on | off.
TAB_RECAP_GLOW=auto
# A summarizer run is killed after this long.
TAB_RECAP_TIMEOUT_MS=180000
