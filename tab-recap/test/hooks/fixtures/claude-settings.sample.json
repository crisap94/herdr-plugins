{
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(git status)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/other-tool session-start",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "effortLevel": "high"
}
