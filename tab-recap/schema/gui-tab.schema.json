{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gui-tab.schema.json",
  "title": "A tab's recap, as the desktop mod reads it",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tab",
    "name",
    "status",
    "at",
    "recapAt",
    "writing",
    "error",
    "lanes",
    "tasks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "tab": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "at": {
      "type": "number"
    },
    "recapAt": {
      "type": [
        "number",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pane",
          "agent",
          "status",
          "title",
          "cwd",
          "lastPrompt",
          "branch",
          "contextPercent",
          "since"
        ],
        "properties": {
          "pane": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "cwd": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastPrompt": {
            "type": [
              "string",
              "null"
            ]
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "contextPercent": {
            "type": [
              "number",
              "null"
            ]
          },
          "since": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "sections",
          "markdown"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "markdown": {
            "type": "string"
          },
          "sections": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "goal",
              "now",
              "needs",
              "done",
              "decisions",
              "next",
              "links"
            ],
            "properties": {
              "goal": {
                "type": "string"
              },
              "now": {
                "$ref": "#/$defs/lines"
              },
              "needs": {
                "$ref": "#/$defs/lines"
              },
              "done": {
                "$ref": "#/$defs/lines"
              },
              "decisions": {
                "$ref": "#/$defs/lines"
              },
              "next": {
                "$ref": "#/$defs/lines"
              },
              "links": {
                "$ref": "#/$defs/lines"
              }
            }
          }
        }
      }
    },
    "writing": {
      "enum": [
        "writing",
        "resting"
      ]
    }
  },
  "$defs": {
    "lines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
