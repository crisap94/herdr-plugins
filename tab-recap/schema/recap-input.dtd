<!-- recap_input: everything tab-recap gives the recap writer for one tab, one run. Version 2. -->
<!ELEMENT recap_input (tab, current_tasks?, ledger+, candidates?, agent_note*, transcript+, correction?)>
<!ATTLIST recap_input version CDATA #FIXED "2">

<!-- The tab and who works in it. now = UTC ISO 8601; zone = IANA name the HH:MM times below use. -->
<!ELEMENT tab (agent+)>
<!ATTLIST tab
  id   CDATA #REQUIRED
  now  CDATA #REQUIRED
  zone CDATA #REQUIRED>

<!-- One agent (lane). id is a1, a2, … (an XML ID, so tasks/notes/transcripts can point at it). -->
<!ELEMENT agent (file*)>
<!ATTLIST agent
  id     ID    #REQUIRED
  kind   CDATA #REQUIRED
  label  CDATA #REQUIRED
  pane   CDATA #REQUIRED
  source (transcript|screen) "transcript"
  cwd    CDATA #IMPLIED
  repo   CDATA #IMPLIED
  branch CDATA #IMPLIED>
<!-- A file the agent edited recently, newest last (at most 5). -->
<!ELEMENT file (#PCDATA)>

<!-- Only when the tab has two or more agents: the grouping to keep unless the transcript says otherwise. -->
<!ELEMENT current_tasks (task+)>
<!ELEMENT task EMPTY>
<!ATTLIST task
  id     CDATA  #REQUIRED
  name   CDATA  #IMPLIED
  agents IDREFS #REQUIRED>

<!-- The facts of one task: its open facts, and the ones closed in the last two hours (state="closed", with closed), newest last.
     The writer answers operations on these by id (f1, f2, … — an XML ID, unique in the document). With several tasks there is
     one ledger per task (task = the id of a task in current_tasks); an empty ledger means the task has no facts yet.
     first / last = when the fact was first and last seen (HH:MM in the tab's zone, or a date when older); why = the reason a
     decision or a close carries; ref = a reference the text is about; anchor = the quote from an earlier input that the fact was added with; agent = the agent whose work the fact is. -->
<!ELEMENT ledger (fact*)>
<!ATTLIST ledger task CDATA #IMPLIED>
<!ELEMENT fact (#PCDATA)>
<!ATTLIST fact
  id      ID    #REQUIRED
  section (goal|now|needs|done|decisions|next|links|rules) #REQUIRED
  state   (open|closed) "open"
  first   CDATA #IMPLIED
  last    CDATA #IMPLIED
  why     CDATA #IMPLIED
  ref     CDATA #IMPLIED
  anchor  CDATA #IMPLIED
  agent   IDREF #IMPLIED
  closed  (done|wrong|superseded|answered|merged|rewritten) #IMPLIED>

<!-- The agent's own words about its work: hints, never facts that beat the transcript. -->
<!ELEMENT agent_note (#PCDATA)>
<!ATTLIST agent_note
  agent   IDREF #REQUIRED
  kind    (away_summary|compaction) #REQUIRED
  at      CDATA #IMPLIED
  clipped (no|tail) "no">

<!-- What is new for one agent since the last recap, oldest first. Empty = nothing new (rewrite only). -->
<!ELEMENT transcript (turn|tools)*>
<!ATTLIST transcript
  agent   IDREF #REQUIRED
  since   CDATA #IMPLIED
  omitted CDATA "0">

<!-- A prompt or a reply. queued = typed while the agent was busy. clipped=middle keeps head and tail. -->
<!ELEMENT turn (#PCDATA)>
<!ATTLIST turn
  role    (user|agent) #REQUIRED
  at      CDATA #IMPLIED
  queued  (yes|no) "no"
  clipped (no|middle) "no">

<!-- One burst of tool use between two turns. reads = plain reads left out; more = calls beyond those shown. -->
<!ELEMENT tools (call*)>
<!ATTLIST tools
  at    CDATA #IMPLIED
  reads CDATA "0"
  more  CDATA "0">
<!-- shell: the command (what = the agent's own description); edit: a path; web: a query or URL. -->
<!ELEMENT call (#PCDATA)>
<!ATTLIST call
  kind (shell|edit|web|agent|other) #REQUIRED
  what CDATA #IMPLIED>

<!-- Only on the retry: the operations that were refused, one per line, each with the reason. -->
<!ELEMENT correction (#PCDATA)>

<!-- Only in the reconcile step of a run: what the enumeration found in the new turns. A new fact is added only from a candidate, copying
     its anchor. anchor = a piece of the input, copied; flagged=yes = a commit, an edit, an error or a question the enumeration left
     unfilled (add it when it is a fact); agent = the agent whose work it is; at = the time of the turn it came from. -->
<!ELEMENT candidates (candidate*)>
<!ELEMENT candidate (#PCDATA)>
<!ATTLIST candidate
  section (goal|now|needs|done|decisions|next|links|rules) #REQUIRED
  anchor  CDATA #REQUIRED
  why     CDATA #IMPLIED
  ref     CDATA #IMPLIED
  agent   IDREF #IMPLIED
  at      CDATA #IMPLIED
  flagged (yes|no) "no">
