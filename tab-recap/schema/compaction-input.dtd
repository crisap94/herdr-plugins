<!-- compaction_input: everything tab-recap gives the brief writer for one agent, one compaction. Version 2. -->
<!ELEMENT compaction_input (agent, note?, current_recap, session_history, recent)>
<!ATTLIST compaction_input version CDATA #FIXED "2">

<!-- The agent about to be compacted. -->
<!ELEMENT agent EMPTY>
<!ATTLIST agent
  kind   CDATA #REQUIRED
  label  CDATA #REQUIRED
  repo   CDATA #IMPLIED
  branch CDATA #IMPLIED>

<!-- What the operator asked the summary to keep above all, verbatim. Absent when none was given. -->
<!ELEMENT note (#PCDATA)>

<!-- The latest recap of the agent's task, as JSON: goal, now, needs, done, decisions, next, links, rules. -->
<!ELEMENT current_recap (#PCDATA)>

<!-- Every fact of the agent's tasks, open and closed, newest last seen first. first/last = when the fact was first and last seen
     (local time, HH:MM or a date); why = the reason a decision or a close carries; closed = why it closed (a closed fact is no longer
     true or no longer needed, but it happened and may still matter). Sections: goal, now, needs, done, decisions, next, links, rules.
     settled = yes: the fact was closed before the agent's last compaction (or the start of a new conversation in its pane), so its
     own earlier summaries hold it already. -->
<!ELEMENT session_history (item*)>
<!ELEMENT item (#PCDATA)>
<!ATTLIST item
  section (goal|now|needs|done|decisions|next|links|rules) #REQUIRED
  state   (open|closed) "open"
  first   CDATA #REQUIRED
  last    CDATA #REQUIRED
  why     CDATA #IMPLIED
  closed  (done|wrong|superseded|answered|merged|rewritten) #IMPLIED
  settled (yes|no) "no">

<!-- The agent's last turns, oldest first (the most recent ones that fit). omitted = turns left out before them. -->
<!ELEMENT recent (turn|tools)*>
<!ATTLIST recent
  since   CDATA #IMPLIED
  omitted CDATA "0">
<!ELEMENT turn (#PCDATA)>
<!ATTLIST turn
  role    (user|agent) #REQUIRED
  at      CDATA #IMPLIED
  queued  (yes|no) "no"
  clipped (no|middle) "no">
<!ELEMENT tools (call*)>
<!ATTLIST tools
  at    CDATA #IMPLIED
  reads CDATA "0"
  more  CDATA "0">
<!ELEMENT call (#PCDATA)>
<!ATTLIST call
  kind (shell|edit|web|agent|other) #REQUIRED
  what CDATA #IMPLIED>
