# atalaya flavour — add these to config.env (see config.example.env for the rest).
# The bridge extension loads on its own when ~/.local/state/atalaya-bridge exists; these only override it.

# atalaya-bridge's state dir (its outbox + heartbeat). Empty disables the extension.
TAB_RECAP_BRIDGE_DIR=~/.local/state/atalaya-bridge
# Start atalaya-bridge.service when its heartbeat is stale and it is not active. 0 = never.
TAB_RECAP_BRIDGE_HEAL=1
