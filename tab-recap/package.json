{
  "name": "herdr-tab-recap",
  "version": "3.0.2",
  "private": true,
  "type": "module",
  "description": "herdr plugin: a recap column on the right of every tab with a coding agent",
  "engines": {
    "bun": ">=1.4.4"
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ],
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "bash ci/lint.sh",
    "test": "bash ci/test.sh",
    "daemon": "bun src/daemon/launch.mjs"
  },
  "dependencies": {
    "@stateforge-labs/harness-adapters": "0.2.0",
    "@stateforge-labs/harness-hooks": "0.3.0",
    "@stateforge-labs/herdr-sdk": "0.4.0",
    "drizzle-orm": "0.45.4",
    "isomorphic-git": "1.44.4"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@types/node": "24.7.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "dependency-cruiser": "18.5.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "6.0.3"
  },
  "license": "MIT"
}
